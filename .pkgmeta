package-as: QuestAnotherDay
enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Dotfiles are excluded automatically by CurseForge's packager.
ignore:
  - QuestData.lua
  - CONTRIBUTING.md
  - CURSEFORGE_DESCRIPTION.md
  - assets
  - audit_quests.py
  - data
  - dist
  - package.json
  - reports
  - scripts
  - test
  - __pycache__
